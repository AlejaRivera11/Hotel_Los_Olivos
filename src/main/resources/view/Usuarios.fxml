<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uniajc.hotellosolivos.controller.UsuariosController">

    <stylesheets>
        <URL value="@/css/Usuarios.css" />
    </stylesheets>

    <left>
        <VBox prefWidth="260.0" spacing="8" styleClass="menu-lateral">

            <Label maxWidth="Infinity" styleClass="titulo-menu" text="HOTEL&#10;LOS OLIVOS" />
            <Region prefHeight="30" />

            <Button maxWidth="Infinity" styleClass="btn-menu" text="Dashboard">
                <graphic>
                    <FontIcon iconLiteral="fas-home" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" styleClass="btn-menu, btn-menu-activo" text="Gestión de Usuarios">
                <graphic>
                    <FontIcon iconLiteral="fas-users" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" styleClass="btn-menu" text="Habitaciones">
                <graphic>
                    <FontIcon iconLiteral="fas-bed" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" styleClass="btn-menu" text="Huéspedes">
                <graphic>
                    <FontIcon iconLiteral="fas-id-badge" />
                </graphic>
            </Button>

            <Separator styleClass="separador-menu" />

            <Button maxWidth="Infinity" styleClass="btn-menu" text="Cerrar Sesión">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <top>
        <HBox spacing="5" styleClass="barra-superior">
            <Label styleClass="avatar">
                <graphic>
                    <FontIcon iconLiteral="fas-user" />
                </graphic>
            </Label>
            <Label styleClass="texto-usuario-actual" text="Administrador General" />
        </HBox>
    </top>

    <center>
        <VBox spacing="20" styleClass="contenido-central">

            <HBox spacing="16" styleClass="encabezado">
                <FontIcon iconLiteral="fas-users" styleClass="icono-titulo" />
                <VBox spacing="2">
                    <Label styleClass="titulo-pagina" text="Gestión de Usuarios" />
                    <Label styleClass="subtitulo-pagina" text="Administra los usuarios del sistema" />
                </VBox>
            </HBox>

            <VBox spacing="18" styleClass="tarjeta">

                <GridPane hgap="24" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <Label styleClass="etiqueta-campo" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label styleClass="etiqueta-campo" text="Usuario" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0" />

                    <TextField fx:id="txtNombre" maxWidth="Infinity" promptText="Ingrese el nombre completo" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtUsuario" maxWidth="Infinity" promptText="Ingrese el usuario" styleClass="campo" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />

                    <Label styleClass="etiqueta-campo, etiqueta-campo-separada" text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label styleClass="etiqueta-campo, etiqueta-campo-separada" text="Rol" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label styleClass="etiqueta-campo, etiqueta-campo-separada" text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                    <PasswordField fx:id="txtContrasena" maxWidth="Infinity" promptText="Ingrese la contraseña" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <ComboBox fx:id="cbRol" maxWidth="Infinity" promptText="Seleccione un rol" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <ComboBox fx:id="cbEstado" maxWidth="Infinity" promptText="Seleccione un estado" styleClass="campo" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                </GridPane>

                <HBox spacing="15">
                    <Button fx:id="btnGuardar" onAction="#guardarUsuario" styleClass="btn-primario" text="Guardar">
                        <graphic>
                            <FontIcon iconLiteral="fas-plus" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnActualizar" onAction="#actualizarUsuario" styleClass="btn-secundario" text="Actualizar">
                        <graphic>
                            <FontIcon iconLiteral="fas-sync-alt" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnLimpiar" onAction="#limpiarFormulario" styleClass="btn-secundario" text="Limpiar">
                        <graphic>
                            <FontIcon iconLiteral="fas-broom" />
                        </graphic>
                    </Button>
                </HBox>

                <Label fx:id="lblMensaje" styleClass="mensaje" />
            </VBox>

            <VBox spacing="16" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                <HBox spacing="10" styleClass="encabezado">
                    <FontIcon iconLiteral="fas-users" styleClass="icono-tarjeta" />
                    <Label styleClass="titulo-tarjeta" text="Listado de Usuarios" />
                </HBox>

                <TableView fx:id="tblUsuarios" styleClass="tabla-usuarios" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" />
                        <TableColumn fx:id="colUsuario" text="Usuario" />
                        <TableColumn fx:id="colRol" text="Rol" />
                        <TableColumn fx:id="colEstado" text="Estado" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>